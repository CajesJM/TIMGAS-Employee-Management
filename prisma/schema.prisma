generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MANAGER
}

enum EmploymentStatus {
  ACTIVE
  RESIGNED
  TERMINATED
  END_OF_CONTRACT
}

enum ContractStatus {
  CURRENT
  EXPIRED
  RENEWED
  TERMINATED
}

enum ViolationStatus {
  OPEN
  RESOLVED
}

enum LeaveTypeCode {
  SICK
  VACATION
  FORCE
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveTransactionType {
  ALLOCATION
  CARRYOVER
  USAGE
  ADJUSTMENT
  REVERSAL
  EXPIRATION
  CASH_CONVERSION
}

enum PayrollPeriodStatus {
  DRAFT
  CALCULATED
  UNDER_REVIEW
  FINALIZED
  REVERSED
}

enum PayrollItemKind {
  EARNING
  DEDUCTION
}

enum LoanStatus {
  ACTIVE
  PAID
  CANCELLED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         UserRole   @default(MANAGER)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]

  @@map("users")
}

model Station {
  id          String              @id @default(cuid())
  code        String              @unique
  name        String              @unique
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  employees   Employee[]
  assignments StationAssignment[]

  @@map("stations")
}

model Department {
  id        String     @id @default(cuid())
  name      String     @unique
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  employees Employee[]

  @@map("departments")
}

model Position {
  id        String     @id @default(cuid())
  name      String     @unique
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  employees Employee[]

  @@map("positions")
}

model Employee {
  id                 String              @id @default(cuid())
  employeeNo         String              @unique
  firstName          String
  middleName         String?
  lastName           String
  departmentId       String
  positionId         String
  stationId          String
  dateHired          DateTime            @db.Date
  dateRegularized    DateTime?           @db.Date
  status             EmploymentStatus    @default(ACTIVE)
  separationDate     DateTime?           @db.Date
  monthlySalary      Decimal             @db.Decimal(12, 2)
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  department         Department          @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  position           Position            @relation(fields: [positionId], references: [id], onDelete: Restrict)
  station            Station             @relation(fields: [stationId], references: [id], onDelete: Restrict)
  stationAssignments StationAssignment[]
  contracts          EmployeeContract[]
  violations         EmployeeViolation[]
  leaveRequests      LeaveRequest[]
  leaveTransactions  LeaveTransaction[]
  payrolls           EmployeePayroll[]
  loans              EmployeeLoan[]

  @@index([lastName, firstName])
  @@index([stationId, status])
  @@map("employees")
}

model StationAssignment {
  id         String    @id @default(cuid())
  employeeId String
  stationId  String
  startDate  DateTime  @db.Date
  endDate    DateTime? @db.Date
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  station    Station   @relation(fields: [stationId], references: [id], onDelete: Restrict)

  @@index([employeeId, startDate])
  @@map("station_assignments")
}

model EmployeeContract {
  id         String         @id @default(cuid())
  employeeId String
  type       String
  startDate  DateTime       @db.Date
  endDate    DateTime       @db.Date
  status     ContractStatus @default(CURRENT)
  notes      String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  employee   Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([endDate, status])
  @@map("employee_contracts")
}

model EmployeeViolation {
  id             String          @id @default(cuid())
  recordNo       String          @unique
  employeeId     String
  category       String
  incidentDate   DateTime        @db.Date
  description    String
  actionTaken    String?
  status         ViolationStatus @default(OPEN)
  resolutionDate DateTime?       @db.Date
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  employee       Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, incidentDate])
  @@map("employee_violations")
}

model LeaveType {
  id               String             @id @default(cuid())
  code             LeaveTypeCode      @unique
  name             String
  annualAllocation Decimal            @db.Decimal(5, 2)
  carriesOver      Boolean            @default(false)
  cashConvertible  Boolean            @default(false)
  expiresAtYearEnd Boolean            @default(false)
  active           Boolean            @default(true)
  requests         LeaveRequest[]
  transactions     LeaveTransaction[]

  @@map("leave_types")
}

model LeaveRequest {
  id           String             @id @default(cuid())
  employeeId   String
  leaveTypeId  String
  startDate    DateTime           @db.Date
  endDate      DateTime           @db.Date
  days         Decimal            @db.Decimal(5, 2)
  reason       String?
  status       LeaveRequestStatus @default(PENDING)
  reviewedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  employee     Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType    LeaveType          @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  transactions LeaveTransaction[]

  @@index([employeeId, startDate])
  @@index([status, startDate])
  @@map("leave_requests")
}

model LeaveTransaction {
  id             String               @id @default(cuid())
  employeeId     String
  leaveTypeId    String
  leaveRequestId String?
  year           Int
  type           LeaveTransactionType
  days           Decimal              @db.Decimal(5, 2)
  effectiveDate  DateTime             @db.Date
  notes          String?
  createdAt      DateTime             @default(now())
  employee       Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType      LeaveType            @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  leaveRequest   LeaveRequest?        @relation(fields: [leaveRequestId], references: [id], onDelete: SetNull)

  @@index([employeeId, leaveTypeId, year])
  @@map("leave_transactions")
}

model PayrollPeriod {
  id          String              @id @default(cuid())
  label       String
  startDate   DateTime            @db.Date
  endDate     DateTime            @db.Date
  paymentDate DateTime            @db.Date
  status      PayrollPeriodStatus @default(DRAFT)
  finalizedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  payrolls    EmployeePayroll[]

  @@unique([startDate, endDate])
  @@index([status, paymentDate])
  @@map("payroll_periods")
}

model EmployeePayroll {
  id               String        @id @default(cuid())
  payrollPeriodId  String
  employeeId       String
  basePay          Decimal       @db.Decimal(12, 2)
  grossPay         Decimal       @db.Decimal(12, 2)
  totalDeductions  Decimal       @db.Decimal(12, 2)
  totalAdjustments Decimal       @db.Decimal(12, 2)
  netPay           Decimal       @db.Decimal(12, 2)
  payslipNo        String?       @unique
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  payrollPeriod    PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Restrict)
  employee         Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  items            PayrollItem[]
  loanPayments     LoanPayment[]

  @@unique([payrollPeriodId, employeeId])
  @@index([employeeId, createdAt])
  @@map("employee_payrolls")
}

model PayItemType {
  id        String          @id @default(cuid())
  code      String          @unique
  name      String
  kind      PayrollItemKind
  recurring Boolean         @default(false)
  active    Boolean         @default(true)
  items     PayrollItem[]

  @@map("pay_item_types")
}

model PayrollItem {
  id                String          @id @default(cuid())
  employeePayrollId String
  payItemTypeId     String
  description       String
  quantity          Decimal?        @db.Decimal(10, 2)
  rate              Decimal?        @db.Decimal(12, 4)
  amount            Decimal         @db.Decimal(12, 2)
  manual            Boolean         @default(false)
  employeePayroll   EmployeePayroll @relation(fields: [employeePayrollId], references: [id], onDelete: Cascade)
  payItemType       PayItemType     @relation(fields: [payItemTypeId], references: [id], onDelete: Restrict)

  @@index([employeePayrollId, payItemTypeId])
  @@map("payroll_items")
}

model EmployeeLoan {
  id          String        @id @default(cuid())
  employeeId  String
  name        String
  principal   Decimal       @db.Decimal(12, 2)
  balance     Decimal       @db.Decimal(12, 2)
  installment Decimal       @db.Decimal(12, 2)
  startDate   DateTime      @db.Date
  status      LoanStatus    @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  employee    Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payments    LoanPayment[]

  @@index([employeeId, status])
  @@map("employee_loans")
}

model LoanPayment {
  id                String          @id @default(cuid())
  employeeLoanId    String
  employeePayrollId String
  amount            Decimal         @db.Decimal(12, 2)
  paidAt            DateTime        @default(now())
  employeeLoan      EmployeeLoan    @relation(fields: [employeeLoanId], references: [id], onDelete: Restrict)
  employeePayroll   EmployeePayroll @relation(fields: [employeePayrollId], references: [id], onDelete: Restrict)

  @@unique([employeeLoanId, employeePayrollId])
  @@map("loan_payments")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}
